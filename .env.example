# Nexus Learn Loop — Environment Template
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-flask-secret-key-change-in-production

# Google Gemini API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Supabase Project URL or PostgreSQL connection string
DATABASE_URL=https://your-project-id.supabase.co

# Supabase Authentication & PostgreSQL Configuration
# Set USE_SUPABASE=true when you want to authenticate via Supabase Auth
USE_SUPABASE=false
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
